DISCORD_TOKEN=your-bot-token
# Optional: only users with this role can use /tellnews (0 = everyone with permissions)
TEAM_ROLE_ID=0
# Join-Log: Kanal-ID, in den der Bot bei jedem Member-Beitritt eine Nachricht sendet
JOIN_LOG_CHANNEL_ID=
# Ticket-System: Kategorien + Team-Rolle (Pflicht für /ticketpanel)
TICKET_CATEGORY_ID=
TICKET_CLAIMED_CATEGORY_ID=
TICKET_STAFF_ROLE_ID=
# Transcript-Webserver: öffentliche Basis-URL (wird in die DM-Links eingebaut) + Host/Port
BASE_URL=http://localhost:8080
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Ticket-Sprachen: pro Sprache eine Rolle per ID zuordnen (ROLLE_ID_<CODE>=Rollen-ID)
# Codes: de, en, fr, es. Mitglieder mit der Rolle bekommen die Ticket-Modals in
# dieser Sprache. Ohne passende Rolle gilt default_language aus languages.json.
# Fallback: Auch Rollennamen wie "German", "Deutsch", "English", "Français" usw.
# werden erkannt - dann ist keine ROLLE_ID_*-Variable nötig.
# ROLLE_ID_DE=
# ROLLE_ID_EN=
# ROLLE_ID_FR=
# ROLLE_ID_ES=
#
# WICHTIG (Portainer): Werden die Variablen nur im Portainer-Stack-UI gesetzt, werden
# sie beim Redeploy oft auf den alten Stand zurückgesetzt. Damit die Werte dauerhaft
# erhalten bleiben, lege zusätzlich eine Datei data/.env im Projektordner auf dem VPS
# an (das data/-Verzeichnis ist als Volume gemountet und wird von Portainer nicht
# angefasst). Der Bot lädt sie automatisch mit höchster Priorität.
# Beispiel-Inhalt von data/.env:
#   JOIN_LOG_CHANNEL_ID=123456789
#   ROLLE_ID_DE=1533222695360266390
#   ROLLE_ID_EN=1533222533313331261
#   ROLLE_ID_FR=1533223257380098149
#   ROLLE_ID_ES=1533222786837778502

